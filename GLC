<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hidden Leaf Cafe | Your New Hangout</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Outfit:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #0a100d; /* Deep forest dark */
            --bg-card: #141c18;
            --text-main: #f0f2ef;
            --text-muted: #9ba39e;
            --accent: #e58d2e; /* Warm ramen/coffee gold */
            --accent-hover: #ff9d33;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body { 
            font-family: 'Outfit', sans-serif; 
            background-color: var(--bg-dark); 
            color: var(--text-main); 
            line-height: 1.6;
            overflow-x: hidden;
        }

        h1, h2, h3 { font-family: 'Cormorant Garamond', serif; font-weight: 600; }

        /* Navigation */
        header {
            position: fixed;
            top: 0; width: 100%;
            padding: 1.5rem 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(10, 16, 13, 0.7);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border-bottom: 1px solid rgba(255,255,255,0.05);
            z-index: 1000;
        }

        .logo { font-size: 1.8rem; font-family: 'Cormorant Garamond', serif; color: var(--accent); letter-spacing: 1px; }
        
        .nav-links a {
            color: var(--text-main);
            text-decoration: none;
            margin-left: 2.5rem;
            font-size: 0.95rem;
            transition: color 0.3s;
            text-transform: uppercase;
            letter-spacing: 2px;
        }
        .nav-links a:hover { color: var(--accent); }

        /* Hero Section */
        .hero {
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            background: linear-gradient(rgba(10, 16, 13, 0.4), rgba(10, 16, 13, 0.9)), 
                        url('https://images.unsplash.com/photo-1554118811-1e0d58224f24?q=80&w=2000&auto=format&fit=crop') center/cover;
            padding: 0 1.5rem;
        }

        .hero-content h1 {
            font-size: clamp(3.5rem, 8vw, 6.5rem);
            line-height: 1.1;
            margin-bottom: 1rem;
            text-shadow: 2px 4px 20px rgba(0,0,0,0.5);
        }

        .hero-content p {
            font-size: 1.2rem;
            color: #d1d6d3;
            max-width: 600px;
            margin: 0 auto 2.5rem auto;
            letter-spacing: 1px;
        }

        .btn {
            background: var(--accent);
            color: #000;
            padding: 1rem 3rem;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 500;
            letter-spacing: 2px;
            text-transform: uppercase;
            transition: all 0.3s ease;
            display: inline-block;
        }
        .btn:hover { background: var(--accent-hover); transform: translateY(-3px); box-shadow: 0 10px 20px rgba(229, 141, 46, 0.3); }

        /* Section Formatting */
        section { padding: 8rem 5%; max-width: 1400px; margin: 0 auto; }
        
        .section-header { text-align: center; margin-bottom: 5rem; }
        .section-header h2 { font-size: 3.5rem; color: var(--accent); margin-bottom: 1rem; }
        .section-header p { color: var(--text-muted); font-size: 1.1rem; letter-spacing: 1px; text-transform: uppercase; }

        /* Menu Grid */
        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 2.5rem;
        }

        .menu-card {
            background: var(--bg-card);
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,0.03);
            transition: transform 0.4s ease, border-color 0.4s ease;
        }

        .menu-card:hover {
            transform: translateY(-10px);
            border-color: var(--accent);
        }

        .menu-img {
            height: 240px;
            width: 100%;
            overflow: hidden;
        }

        .menu-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
        }

        .menu-card:hover .menu-img img { transform: scale(1.1); }

        .menu-info { padding: 2rem; }
        .menu-info h3 { font-size: 1.8rem; margin-bottom: 0.5rem; display: flex; justify-content: space-between; }
        .price { color: var(--accent); font-family: 'Outfit', sans-serif; font-weight: 500; }
        .menu-info p { color: var(--text-muted); font-size: 0.95rem; }

        /* Vibe/Gallery */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.5rem;
        }
        .gallery-item {
            height: 400px;
            border-radius: 16px;
            overflow: hidden;
        }
        .gallery-item img {
            width: 100%; height: 100%; object-fit: cover;
            transition: filter 0.4s ease, transform 0.6s ease;
            filter: grayscale(40%) brightness(0.8);
        }
        .gallery-item:hover img {
            filter: grayscale(0%) brightness(1);
            transform: scale(1.05);
        }

        /* Footer */
        footer {
            background: #060907;
            padding: 4rem 5%;
            text-align: center;
            border-top: 1px solid rgba(255,255,255,0.05);
        }
        footer h2 { font-size: 2.5rem; color: var(--text-main); margin-bottom: 1.5rem; }
        footer p { color: var(--text-muted); margin-bottom: 2rem; }

        /* Animations */
        .reveal { opacity: 0; transform: translateY(50px); transition: all 0.8s cubic-bezier(0.5, 0, 0, 1); }
        .reveal.active { opacity: 1; transform: translateY(0); }

        @media (max-width: 900px) {
            .gallery-grid { grid-template-columns: 1fr; }
            .nav-links { display: none; }
            .gallery-item { height: 300px; }
        }
    </style>
</head>
<body>

    <header>
        <div class="logo">Hidden Leaf</div>
        <div class="nav-links">
            <a href="#menu">Our Menu</a>
            <a href="#vibe">The Vibe</a>
            <a href="#visit">Visit Us</a>
        </div>
    </header>

    <div class="hero">
        <div class="hero-content reveal active">
            <h1>Come for the coffee.<br>Stay for the chakra.</h1>
            <p>Your new favorite hangout. Hand-crafted ramen, specialty coffee, and a cozy aesthetic tucked away from the noise.</p>
            <a href="#menu" class="btn">Explore Menu</a>
        </div>
    </div>

    <section id="menu">
        <div class="section-header reveal">
            <p>Taste the Village</p>
            <h2>Signature Servings</h2>
        </div>
        
        <div class="menu-grid">
            <!-- Item 1 -->
            <div class="menu-card reveal">
                <div class="menu-img">
                    <img src="https://images.unsplash.com/photo-1569718212165-3a8278d5f624?q=80&w=800&auto=format&fit=crop" alt="Spicy Miso Ramen">
                </div>
                <div class="menu-info">
                    <h3>Spicy Miso Ramen <span class="price">₹350</span></h3>
                    <p>Rich pork broth, chili oil, soft-boiled egg, fresh scallions, and nori. A village classic.</p>
                </div>
            </div>
            
            <!-- Item 2 -->
            <div class="menu-card reveal" style="transition-delay: 0.1s;">
                <div class="menu-img">
                    <img src="https://images.unsplash.com/photo-1559525839-b184a4d698c7?q=80&w=800&auto=format&fit=crop" alt="Hidden Leaf Special Brew">
                </div>
                <div class="menu-info">
                    <h3>Leaf Special Pour-Over <span class="price">₹180</span></h3>
                    <p>Single-origin arabica beans, slowly dripped to perfection with subtle hints of dark chocolate and orange.</p>
                </div>
            </div>

            <!-- Item 3 -->
            <div class="menu-card reveal" style="transition-delay: 0.2s;">
                <div class="menu-img">
                    <img src="https://images.unsplash.com/photo-1564834724105-918b73d1b9e0?q=80&w=800&auto=format&fit=crop" alt="Crispy Dumplings">
                </div>
                <div class="menu-info">
                    <h3>Pan-Seared Gyoza <span class="price">₹220</span></h3>
                    <p>Crispy on the bottom, juicy on the inside. Served with our signature house-made soy vinegar dipping sauce.</p>
                </div>
            </div>
        </div>
    </section>

    <section id="vibe">
        <div class="section-header reveal">
            <p>The Atmosphere</p>
            <h2>Step Inside</h2>
        </div>
        <div class="gallery-grid">
            <div class="gallery-item reveal"><img src="https://images.unsplash.com/photo-1497935586351-b67a49e012bf?q=80&w=800&auto=format&fit=crop" alt="Cafe Interior"></div>
            <div class="gallery-item reveal" style="transition-delay: 0.1s;"><img src="https://images.unsplash.com/photo-1600093463592-8e36ae95ef56?q=80&w=800&auto=format&fit=crop" alt="Coffee Pour"></div>
            <div class="gallery-item reveal" style="transition-delay: 0.2s;"><img src="https://images.unsplash.com/photo-1555396273-367ea4eb4db5?q=80&w=800&auto=format&fit=crop" alt="Neon Sign"></div>
        </div>
    </section>

    <footer id="visit">
        <div class="reveal">
            <h2>Find Your Spot.</h2>
            <p>Open Monday to Sunday | 10:00 AM – 11:00 PM</p>
            <p style="margin-bottom: 2rem;">123 Village Road, Near The Center<br>Call us: +91 98765 43210</p>
            <a href="#" class="btn">Order Online</a>
        </div>
    </footer>

    <script>
        function reveal() {
            var reveals = document.querySelectorAll(".reveal");
            for (var i = 0; i < reveals.length; i++) {
                var windowHeight = window.innerHeight;
                var elementTop = reveals[i].getBoundingClientRect().top;
                if (elementTop < windowHeight - 100) {
                    reveals[i].classList.add("active");
                }
            }
        }
        window.addEventListener("scroll", reveal);
        reveal(); // Trigger on load
    </script>
</body>
</html>
